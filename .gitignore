# Python caches / environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
**/.venv/
.env
.env.*
!.env.example

# Local hardware overrides; shared hardware profiles are stored under config/hardware/.
config/hardware.local.toml
config/*.local.toml
config/hardware/*.local.toml

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local data and model artifacts (do not commit large files)
dataset/train/*
!dataset/train/.gitkeep
dataset/staging/*
!dataset/staging/.gitkeep
dataset/replay/*
!dataset/replay/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
assets/*
!assets/.gitkeep
logs/*
!logs/.gitkeep

# Runtime outputs
*.log
*.pid

# OpenPI runtime files and caches remain ignored; OpenPI source is tracked by
# this repository as a regular directory.

# Parent package build and verification caches
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local development plans, audits and validation records
/docs/superpowers/
/docs/gello_integration_plan.md
/docs/gello_integration_validation.md
/teleop/gello_cr/docs/superpowers/
/teleop/gello_cr/docs/legacy_audit.md
/teleop/gello_cr/docs/release_v1.md
/teleop/gello_cr/docs/stability_review.md
/teleop/gello_cr/docs/ui_ux_architecture_audit.md
