# Python caches / environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
**/.venv/
.env
.env.*
!.env.example

# Local hardware overrides (the checked-in baseline is config/hardware.toml)
config/hardware.local.toml
config/*.local.toml

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local data and model artifacts (do not commit large files)
dataset/train/*
!dataset/train/.gitkeep
dataset/replay/*
!dataset/replay/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
assets/*
!assets/.gitkeep
logs/*
!logs/.gitkeep

# Runtime outputs
*.log
*.pid

# OpenPI runtime files and caches remain ignored; OpenPI source is tracked by
# this repository as a regular directory.
